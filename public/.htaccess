Options -Indexes
# MAMP serves PHP through mod_fastcgi, which does not populate PHP_AUTH_*.
CGIPassAuth On
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
RewriteEngine On
RewriteCond %{HTTP:Authorization} ^(.+)$
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%1]
RewriteRule ^$ index.php [L]
RewriteRule ^api(?:/.*)?$ api.php [L,QSA]
RewriteRule ^watch/([a-f0-9]{64})$ player.php?id=$1 [L,QSA]
RewriteRule ^embed/([a-f0-9]{64})$ player.php?id=$1&embed=1 [L,QSA]
RewriteRule ^watch/([A-Za-z0-9][A-Za-z0-9._-]*)/([A-Za-z0-9][A-Za-z0-9._-]*)$ player.php?collection=$1&key=$2 [L,QSA]
RewriteRule ^embed/([A-Za-z0-9][A-Za-z0-9._-]*)/([A-Za-z0-9][A-Za-z0-9._-]*)$ player.php?collection=$1&key=$2&embed=1 [L,QSA]
RewriteRule ^media/[a-f0-9]{2}/[a-f0-9]{2}/([a-f0-9]{64})/(index\.m3u8|segment[0-9]{5}\.ts|captions\.vtt)$ media.php?id=$1&file=$2 [L,QSA]
